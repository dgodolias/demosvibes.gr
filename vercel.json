{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "regions": ["fra1"],
  "routes": [
    { "src": "^/$", "methods": ["POST"], "dest": "/api/legacy-subscribe" }
  ],
  "functions": {
    "api/subscribe.ts": { "maxDuration": 15 },
    "api/legacy-subscribe.ts": { "maxDuration": 15 }
  }
}
